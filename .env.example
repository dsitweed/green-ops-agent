# OpenAPI configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_MODEL_NAME = "apu-gpt-5.6-sol"
OPENAI_API_BASE_URL = "https://luvenia-uncommuted-hypermorally.ngrok-free.dev/v1"

# Pipeline mode
PIPELINE_MODE=production # Options: production, simulation

# AWS SDK configuration
AWS_PROFILE=my-finops-readonly
AWS_DEFAULT_REGION=ap-northeast-1

# Absolute or workspace-relative path to the CFM Tips MCP server
CFM_MCP_SERVER=mcps/sample-cfm-tips-mcp/mcp_server_with_runbooks.py
CFM_MCP_PYTHON=mcps/sample-cfm-tips-mcp/.venv/bin/python

# Discovery request
FINOPS_APPLICATION=Taco House
FINOPS_ENVIRONMENT=staging
FINOPS_PROTECTED=false
FINOPS_EVIDENCE_WINDOW_DAYS=14

# Cloud Custodian governance
CUSTODIAN_ALLOWED_ACCOUNTS=111111111111
CUSTODIAN_BLOCKED_ACCOUNTS=production,management,security
CUSTODIAN_ALLOWED_REGIONS=ap-northeast-1